<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the auth session (stored by the Supabase SDK in
     SharedPreferences) must not be restored onto another device, and all other local data
     is a cache that is re-fetched from the backend. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
