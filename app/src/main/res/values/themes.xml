<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only. All in-app styling comes from MusicSocialTheme (Compose).
         The dark window background avoids a white flash before the first frame. -->
    <style name="Theme.Butter" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <color name="window_background">#0B0B0F</color>
</resources>
