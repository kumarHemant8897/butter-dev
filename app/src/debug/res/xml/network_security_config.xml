<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so the app can reach a local Supabase stack (`supabase start`)
     on the developer PC, whether over `adb reverse` (127.0.0.1), the emulator (10.0.2.2) or the home
     Wi-Fi (the PC's address changes when the router hands out a new one, and Android cannot list an
     address range here). Release builds use app/src/main/res/xml/network_security_config.xml, which
     allows HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
